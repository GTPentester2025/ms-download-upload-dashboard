# The environment wins over this file, and MSDU_CONFIG_FILE can name another
# file instead (for example one a secrets manager renders).
#
# Copy to config.env (git-ignored) beside ms_download_upload.py and fill in.
NETSKOPE_BASE_URL=https://YOUR_TENANT.goskope.com
NETSKOPE_API_TOKEN=PUT_YOUR_API_TOKEN_HERE
# bearer, or netskope if the tenant answers 401
NETSKOPE_AUTH_MODE=bearer
